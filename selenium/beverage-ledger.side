  "tests": [
    {
      "id": "00000000-0000-4000-8000-000000000900",
      "name": "RF-01 (error) - credenciales inexistentes se rechazan",
      "commands": [
        {
          "id": "00000000-0000-4000-8000-000000000001",
          "comment": "",
          "command": "open",
          "target": "/login",
          "targets": [],
          "value": ""
        },
        {
          "id": "00000000-0000-4000-8000-000000000002",
          "comment": "",
          "command": "executeAsyncScript",
          "target": "return new Promise((resolve) => { const poll = () => (window.next && window.next.router && Array.from(document.forms).every((f) => Object.keys(f).some((k) => k.startsWith('__reactProps'))) ? resolve(true) : setTimeout(poll, 100)); poll(); })",
          "targets": [],
          "value": ""
        },
        {
          "id": "00000000-0000-4000-8000-000000000003",
          "comment": "",
          "command": "type",
          "target": "css=input[type=\"email\"]",
          "targets": [],
          "value": "nadie+selenium@beverageledger.test"
        },
        {
          "id": "00000000-0000-4000-8000-000000000004",
          "comment": "",
          "command": "type",
          "target": "css=input[type=\"password\"]",
          "targets": [],
          "value": "NoExiste-2026"
        },
        {
          "id": "00000000-0000-4000-8000-000000000005",
          "comment": "",
          "command": "click",
          "target": "css=form button[type=\"submit\"]",
          "targets": [],
          "value": ""
        },
        {
          "id": "00000000-0000-4000-8000-000000000006",
          "comment": "",
          "command": "waitForElementVisible",
          "target": "css=form [role=\"alert\"]",
          "targets": [],
          "value": "30000"
        },
        {
          "id": "00000000-0000-4000-8000-000000000007",
          "comment": "",
          "command": "assertText",
          "target": "css=form [role=\"alert\"]",
          "targets": [],
          "value": "Invalid email or password"
        },
        {
          "id": "00000000-0000-4000-8000-000000000008",
          "comment": "",
          "command": "executeScript",
          "target": "return location.pathname",
          "targets": [],
          "value": "ruta"
        },
        {
          "id": "00000000-0000-4000-8000-000000000009",
          "comment": "",
          "command": "assert",
          "target": "ruta",
          "targets": [],
          "value": "/login"
        }
      ]
    },
    {
